<group name="local,syslog,sshd,windows,powershell,rdp_attack,ingress_tool_transfer,persistence,">

  <!-- Regla 100001: Autenticación SSH fallida puntual -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: intento de autenticación fallido desde la IP $(srcip).</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Regla 100010: Fuerza Bruta RDP (MITRE T1110 / T1110.001) -->
  <rule id="100010" level="10" frequency="4" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>data.win.eventdata.ipAddress</same_field>
    <description>SOC Detection: múltiples fallos de logon RDP detectados desde la misma IP (posible fuerza bruta - MITRE T1110)</description>
    <mitre>
      <id>T1110</id>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Regla 100011: Escalamiento Atacante Persistente RDP (MITRE T1110) -->
  <rule id="100011" level="12" frequency="3" timeframe="1800">
    <if_matched_sid>100010</if_matched_sid>
    <same_field>data.win.eventdata.ipAddress</same_field>
    <description>SOC Detection: IP con fuerza bruta RDP recurrente pese a contención previa (atacante persistente - MITRE T1110)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,attack,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Regla 100020: Ejecución de PowerShell Codificado (MITRE T1059.001) -->
  <rule id="100020" level="12">
    <if_group>windows</if_group>
    <field name="win.eventdata.commandLine">(?i)-e|-enc|-encodedcommand</field>
    <description>SOC Detection: ejecución de PowerShell ofuscado/codificado en Base64 (MITRE T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,powershell,</group>
  </rule>

  <!-- Regla 100021: ScriptBlock Logging Event ID 4104 (MITRE T1059.001) -->
  <rule id="100021" level="10">
    <if_sid>91802</if_sid>
    <description>SOC Detection: auditoría de ScriptBlock Logging de PowerShell (MITRE T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,powershell,</group>
  </rule>

  <!-- Regla 100030: Persistencia vía Tareas Programadas (MITRE T1053.005) -->
  <rule id="100030" level="10">
    <if_group>windows</if_group>
    <field name="win.eventdata.image">\\schtasks\.exe</field>
    <field name="win.eventdata.commandLine">/create</field>
    <field name="win.eventdata.commandLine">SYSTEM</field>
    <description>SOC Detection: Creación de Tarea Programada con privilegios SYSTEM (Persistencia - MITRE T1053.005)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>windows,persistence,task_scheduler,</group>
  </rule>

  <!-- Regla 100050: Descarga sospechosa vía LOLBin certutil.exe (MITRE T1105) -->
  <rule id="100050" level="12">
    <if_group>windows</if_group>
    <field name="win.eventdata.commandLine">(?i)certutil.*-urlcache</field>
    <description>SOC Detection: descarga sospechosa de herramienta/payload vía certutil.exe (Ingress Tool Transfer - MITRE T1105)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>execution,lolbin,ingress_tool_transfer,</group>
  </rule>

</group>
